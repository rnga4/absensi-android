# Salin file ini menjadi `keystore.properties` di root project, lalu isi
# sesuai keystore release Anda. File keystore.properties TIDAK boleh di-commit
# (sudah masuk .gitignore). Kalau tidak ada, build tetap berjalan memakai
# debug signing (untuk keperluan pengujian lokal).
#
STORE_FILE=/absolut/path/keystore.jks
STORE_PASSWORD=rahasia
KEY_ALIAS=absensi
KEY_PASSWORD=rahasia